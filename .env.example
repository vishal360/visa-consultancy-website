# Copy to `.env` and edit. Anything already set in the real environment wins.

# ---------- Server ----------
HOST=0.0.0.0
PORT=8000
DEBUG=true
BASE_URL=http://localhost:8000

# ---------- Branding ----------
BRAND_NAME=V&P UkraLink
BRAND_TAGLINE=Ukraine visa & immigration consultants
CONTACT_EMAIL=vpukralink@gmail.com
CONTACT_PHONE=+91 7048900551

# ---------- Security ----------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
SESSION_TTL_HOURS=12
# Set to true once you are serving over HTTPS.
SECURE_COOKIES=false

# ---------- Bootstrap admin account ----------
# Created automatically on first run if the admin table is empty.
ADMIN_EMAIL=vpukralink@gmail.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Consultant

# ---------- Email (SMTP) ----------
# Leave SMTP_HOST empty to run in offline mode: emails are written as .eml files
# to data/outbox/ and logged in the database instead of being sent.
#
# Gmail example (use a Google App Password, not your login password --
# generate one at https://myaccount.google.com/apppasswords):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=true
#   SMTP_USER=vpukralink@gmail.com
#   SMTP_PASSWORD=your-16-character-app-password
# SendGrid example:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASSWORD=SG.xxxxx
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=20
MAIL_FROM=vpukralink@gmail.com
MAIL_FROM_NAME=V&P UkraLink
# Who receives new booking / enquiry notifications (comma-separated).
NOTIFY_EMAILS=vpukralink@gmail.com

# ---------- Booking rules ----------
# Slot times in app/config.py OPENING_HOURS are wall-clock times in this zone.
# The offset does the real arithmetic; the label is only what visitors see.
# 330 minutes = UTC+5:30 = IST. India has no DST, so a fixed offset is exact.
TIMEZONE_LABEL=IST (UTC+5:30)
TIMEZONE_OFFSET_MINUTES=330
SLOT_MINUTES=45
MIN_LEAD_HOURS=12
BOOKING_WINDOW_DAYS=60
MAX_PER_SLOT=1

# ---------- Rate limiting ----------
RATE_LIMIT_MAX=12
RATE_LIMIT_WINDOW_SECONDS=600
