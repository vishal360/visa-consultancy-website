# Copy to `.env` and edit. Anything already set in the real environment wins.

# ---------- Server ----------
HOST=0.0.0.0
PORT=8000
DEBUG=true
BASE_URL=http://localhost:8000

# ---------- Branding ----------
BRAND_NAME=Dnipro Visa Partners
BRAND_TAGLINE=Ukraine immigration & visa specialists
CONTACT_EMAIL=hello@dniprovisa.example
CONTACT_PHONE=+380 44 123 4567
OFFICE_ADDRESS=12 Khreshchatyk St, Kyiv 01001, Ukraine

# ---------- Security ----------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
SESSION_TTL_HOURS=12
# Set to true once you are serving over HTTPS.
SECURE_COOKIES=false

# ---------- Bootstrap admin account ----------
# Created automatically on first run if the admin table is empty.
ADMIN_EMAIL=admin@dniprovisa.example
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Consultant

# ---------- Email (SMTP) ----------
# Leave SMTP_HOST empty to run in offline mode: emails are written as .eml files
# to data/outbox/ and logged in the database instead of being sent.
#
# Gmail example (use a Google App Password, not your login password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=true
# SendGrid example:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASSWORD=SG.xxxxx
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=20
MAIL_FROM=hello@dniprovisa.example
MAIL_FROM_NAME=Dnipro Visa Partners
# Who receives new booking / enquiry notifications (comma-separated).
NOTIFY_EMAILS=hello@dniprovisa.example

# ---------- Booking rules ----------
TIMEZONE_LABEL=EET (UTC+2)
SLOT_MINUTES=45
MIN_LEAD_HOURS=12
BOOKING_WINDOW_DAYS=60
MAX_PER_SLOT=1

# ---------- Rate limiting ----------
RATE_LIMIT_MAX=12
RATE_LIMIT_WINDOW_SECONDS=600
